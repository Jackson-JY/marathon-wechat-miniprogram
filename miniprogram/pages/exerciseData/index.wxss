.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  color: white;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 24rpx;
  opacity: 0.9;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.form-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.label {
  min-width: 160rpx;
  font-size: 28rpx;
  color: #666;
}

.input {
  flex: 1;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #fafafa;
}

.picker {
  flex: 1;
}

.picker-text {
  height: 80rpx;
  line-height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #fafafa;
  color: #333;
}

.btn {
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  margin-top: 20rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.btn-secondary {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
}

.btn-info {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: white;
}

.btn-success {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: white;
}

.stats {
  margin-top: 30rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 12rpx;
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.record-list {
  margin-top: 20rpx;
}

.record-item {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #667eea;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.record-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.record-type {
  background: #667eea;
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.record-details {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 15rpx;
}

.detail {
  background: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666;
}

.record-time {
  text-align: right;
}

.time {
  font-size: 22rpx;
  color: #999;
}

.log-list {
  margin-top: 20rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.log-time {
  font-size: 22rpx;
  color: #999;
  min-width: 120rpx;
}

.log-message {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  margin-left: 20rpx;
}

/* 文本数据输入相关样式 */
.textarea {
  width: 100%;
  height: 200rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 26rpx;
  background: #fafafa;
  resize: none;
  font-family: 'Courier New', monospace;
}

.preview-container {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #e0e0e0;
}

.preview-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.preview-count {
  font-size: 22rpx;
  color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
}

.preview-content {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.preview-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  padding: 15rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #667eea;
}

.preview-name {
  flex: 1;
  font-size: 24rpx;
  font-weight: 500;
  color: #333;
}

.preview-type {
  background: #667eea;
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  margin: 0 10rpx;
}

.preview-distance {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

.preview-more {
  text-align: center;
  padding: 10rpx;
  color: #999;
  font-size: 22rpx;
  background: white;
  border-radius: 8rpx;
}

.preview-empty {
  text-align: center;
  padding: 40rpx 20rpx;
}

.preview-empty-text {
  color: #999;
  font-size: 24rpx;
}

.options-container {
  display: flex;
  gap: 30rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.option-label {
  font-size: 26rpx;
  color: #666;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.form-actions .btn {
  flex: 1;
}

/* 文件上传相关样式 */
.format-tags {
  display: flex;
  gap: 15rpx;
  flex-wrap: wrap;
}

.format-tag {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.file-upload-area {
  border: 2rpx dashed #e0e0e0;
  border-radius: 16rpx;
  padding: 40rpx 20rpx;
  text-align: center;
  background: #fafafa;
  transition: all 0.3s ease;
  cursor: pointer;
}

.file-upload-area:active {
  border-color: #667eea;
  background: #f0f4ff;
  transform: scale(0.98);
}

.upload-icon {
  font-size: 48rpx;
  margin-bottom: 20rpx;
}

.upload-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.upload-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.upload-hint {
  font-size: 22rpx;
  color: #999;
}

.file-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
}

.file-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  margin-right: 20rpx;
  word-break: break-all;
}

.file-size {
  background: #667eea;
  color: white;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  margin-right: 15rpx;
}

.file-type {
  background: #28a745;
  color: white;
  padding: 6rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
}

.progress-bar {
  width: 100%;
  height: 20rpx;
  background: #e0e0e0;
  border-radius: 10rpx;
  overflow: hidden;
  margin-bottom: 10rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #764ba2);
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 22rpx;
  color: #667eea;
  text-align: center;
  display: block;
}

.file-preview {
  background: #f8f9fa;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 20rpx;
  max-height: 200rpx;
  overflow-y: auto;
}

.preview-text {
  font-size: 24rpx;
  color: #666;
  font-family: 'Courier New', monospace;
  line-height: 1.5;
  white-space: pre-wrap;
}
